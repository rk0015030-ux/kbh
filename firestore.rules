rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidScore(data) {
      return data.keys().hasAll(['playerId', 'name', 'roomId', 'score']) &&
             data.playerId is string && data.playerId.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.roomId is string && data.roomId.size() <= 100 &&
             data.score is number;
    }

    function isValidMedia(data) {
      return data.keys().hasAll(['id', 'name', 'url', 'type']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 255 &&
             data.url is string && data.url.size() <= 1024 &&
             data.type in ['image', 'video', 'audio'];
    }

    // Public read for scores so host and player leaderboards can display
    match /scores/{scoreId} {
      allow read: if true;
      allow create: if isValidId(scoreId) && isValidScore(request.resource.data);
      allow update: if isValidId(scoreId) && isValidScore(request.resource.data);
      allow delete: if isValidId(scoreId);
    }

    // Media index items
    match /media/{mediaId} {
      allow read: if true;
      allow create, update: if isValidId(mediaId);
      allow delete: if isValidId(mediaId);

      // Binary chunks for persistent storage across app restarts
      match /chunks/{chunkId} {
        allow read: if true;
        allow write: if true;
      }
    }

    // Direct media collections if created manually or via Firebase Console
    match /images/{id} {
      allow read, write: if true;
    }
    match /videos/{id} {
      allow read, write: if true;
    }
    match /audio/{id} {
      allow read, write: if true;
    }
    match /audios/{id} {
      allow read, write: if true;
    }
    match /files/{id} {
      allow read, write: if true;
    }
    match /uploads/{id} {
      allow read, write: if true;
    }
  }
}
